# Copie para .env e preencha localmente. Nunca versione credenciais.
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
# PostgreSQL direto, porta 5432. Não use o pooler em modo transação.
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
# E-mail de boas-vindas e redefinição de senha. Vazio = mensagens saem no terminal.
# Ex.: smtp+tls://usuario:senha-de-app@smtp.gmail.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=
# Numero de proxies HTTPS na frente da aplicacao (em geral 1 em producao).
PROXY_COUNT=0
